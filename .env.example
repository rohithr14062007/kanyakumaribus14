# Supabase Database Configuration
# Copy your connection string from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Example: SUPABASE_DB_URL=postgresql://postgres.your_project_id:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

SUPABASE_DB_URL=

# OR fill individual credentials below:
SUPABASE_HOST=
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
SUPABASE_DBNAME=postgres
SUPABASE_PORT=5432
